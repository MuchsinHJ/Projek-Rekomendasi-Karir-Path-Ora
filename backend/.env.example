# ============================================================
# Path'Ora Backend - Environment Variables
# Salin file ini menjadi `.env` lalu sesuaikan nilainya.
# ============================================================

# --- Server ---
PORT=4000
NODE_ENV=development

# CORS: origin frontend (Vite dev server default 5173). Pisahkan dengan koma untuk banyak origin.
CORS_ORIGIN=http://localhost:5173

# --- Database (PostgreSQL) ---
# Gunakan salah satu: DATABASE_URL ATAU variabel PG* di bawahnya.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/pathora
# PGHOST=localhost
# PGPORT=5432
# PGUSER=postgres
# PGPASSWORD=postgres
# PGDATABASE=pathora
# Set true bila provider DB mewajibkan SSL (mis. Railway/Render/Supabase).
PGSSL=false

# --- Auth (JWT) ---
JWT_SECRET=ganti-dengan-secret-acak-yang-panjang
JWT_EXPIRES_IN=7d

# --- AI / ML Service ---
# AI_PROVIDER: "mock" (default, tanpa layanan AI) atau "http" (panggil layanan AI nyata).
AI_PROVIDER=mock
AI_SERVICE_URL=http://localhost:8000/analyze
AI_TIMEOUT_MS=30000

# --- Upload ---
MAX_UPLOAD_MB=5
