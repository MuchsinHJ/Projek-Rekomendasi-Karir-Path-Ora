{
  "name": "pathora-backend",
  "version": "1.0.0",
  "description": "Path'Ora RESTful API - Platform End-to-End Kesiapan Kerja (Express + PostgreSQL)",
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "db:migrate": "node src/db/migrate.js",
    "db:seed": "node src/db/seed.js",
    "db:setup": "node src/db/migrate.js && node src/db/seed.js",
    "test:ai": "node scripts/test-ai-adapter.js"
  },
  "keywords": [
    "pathora",
    "express",
    "postgres",
    "rest-api",
    "cv-analysis"
  ],
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "pg": "^8.12.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "nodemon": "^3.1.4"
  }
}
